{
  "name": "latache-backend-nestjs-prisma",
  "version": "3.26.2",
  "description": "Latache API with Super-Admin-owned referral/reward policy and backend-enforced Elite perk entitlements, hardened dispute lifecycle, production referral accounting, private/support chat, transactional realtime, WebRTC signaling, completion approval, secure auth, en/ar/ary localization, Redis/BullMQ, provider-backed finance, Prisma/PostgreSQL, Stripe, and RBAC",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.ts\" \"docs/**/*.md\"",
    "start": "node --enable-source-maps dist/main.js",
    "start:prod": "node --enable-source-maps dist/main.js",
    "start:worker": "SERVICE_MODE=worker node --enable-source-maps dist/main.js",
    "start:dev": "prisma generate && nest start --watch",
    "start:debug": "prisma generate && nest start --debug --watch",
    "lint": "eslint \"{src,test,prisma,scripts}/**/*.ts\"",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --watch --config jest.config.ts",
    "test:cov": "jest --coverage --config jest.config.ts",
    "test:e2e": "jest --config test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "migration:up": "npm run prisma:migrate:deploy",
    "seed:all": "npm run prisma:seed",
    "verify:static": "node --import tsx scripts/verify-project.ts",
    "verify": "npm run verify:static && npm run prisma:validate && npm run build && npm run lint && npm test -- --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.1.28",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@socket.io/redis-adapter": "8.3.0",
    "bcryptjs": "3.0.3",
    "bullmq": "5.81.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cloudinary": "2.10.0",
    "compression": "1.8.1",
    "dotenv": "17.2.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nodemailer": "9.0.4",
    "pg": "8.22.0",
    "prisma": "7.9.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "stripe": "22.4.0",
    "tsx": "4.20.3"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.28",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.17.2",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.20.3",
    "@types/supertest": "6.0.3",
    "eslint": "9.32.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "supertest": "7.1.4",
    "ts-jest": "29.4.12",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0"
  },
  "packageManager": "npm@10.9.2",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
