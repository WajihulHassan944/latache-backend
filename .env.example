NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000
APP_TIMEZONE=Africa/Casablanca
REQUEST_BODY_LIMIT=1mb
SWAGGER_ENABLED=true
TRUST_PROXY=false
SERVICE_MODE=all
HTTP_COMPRESSION_ENABLED=true
HTTP_COMPRESSION_THRESHOLD_BYTES=1024
SLOW_REQUEST_MS=1000

# Authenticated Socket.IO realtime delivery. Persisted mutations remain REST-first;
# the outbox pushes committed notifications/messages/status/location updates.
REALTIME_ENABLED=true
REALTIME_OUTBOX_POLL_MS=500
REALTIME_OUTBOX_BATCH_SIZE=100
REALTIME_OUTBOX_LOCK_MS=30000
REALTIME_OUTBOX_RETENTION_HOURS=24
REALTIME_SESSION_SWEEP_MS=30000
REALTIME_TYPING_THROTTLE_MS=300
REALTIME_LOCATION_MIN_WRITE_INTERVAL_MS=1000
REALTIME_OUTBOX_CLEANUP_INTERVAL_MS=3600000
REALTIME_OUTBOX_CLEANUP_BATCH_SIZE=1000

# Railway Redis: set REDIS_URL to the private URL exposed by the Railway Redis
# service. PostgreSQL remains authoritative; Redis owns cache, BullMQ transport,
# and Socket.IO cross-replica pub/sub only.
REDIS_URL=
REDIS_ENABLED=false
# Set true in a scaled API/worker topology where cross-replica realtime and jobs
# are required. /api/health reports an outage as unhealthy instead of masking it.
REDIS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_MS=2000

CACHE_ENABLED=true
CACHE_KEY_PREFIX=latache:v1
CACHE_SERVICES_TTL_SECONDS=300
CACHE_SETTINGS_TTL_SECONDS=300
CACHE_ELITE_TTL_SECONDS=120
CACHE_ADMIN_ANALYTICS_TTL_SECONDS=30

# In local Redis-free development, JOBS_ENABLED=false keeps the existing safe
# database-driven finance/call fallback. For Railway, enable jobs, run the API
# with SERVICE_MODE=api, and run a separate service with SERVICE_MODE=worker.
JOBS_ENABLED=false
JOB_WORKER_ENABLED=false
JOB_SCHEDULER_ENABLED=false
JOB_MAINTENANCE_QUEUE_NAME=latache-maintenance-v1
JOB_WORKER_CONCURRENCY=4
JOB_ATTEMPTS=5
JOB_LOCK_DURATION_MS=60000
JOB_HEALTH_TIMEOUT_MS=2000

# Local PostgreSQL example:
DATABASE_URL=postgresql://latache:latache@localhost:5432/latache?schema=public

# Neon example (replace placeholders and rotate any credential shared publicly):
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require
# DIRECT_URL can remain empty for a direct Neon URL. When DATABASE_URL uses a
# pooled host, set DIRECT_URL to the non-pooled connection for migrations.
DIRECT_URL=
DB_LOGGING=false
DB_TRANSACTION_MAX_WAIT_MS=15000
DB_TRANSACTION_TIMEOUT_MS=30000
DB_POOL_MAX_PER_INSTANCE=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_SLOW_QUERY_MS=750


# Cloudinary server-side uploads. Never expose API_SECRET to a frontend.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=latache
CLOUDINARY_MAX_FILE_SIZE_BYTES=10485760

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_SECRET_ADMIN=replace-with-an-independent-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
BCRYPT_ROUNDS=12
OTP_EXPIRES_IN_MINUTES=5
PASSWORD_RESET_OTP_EXPIRES_IN_MINUTES=15

# Local Docker Compose uses Mailpit on localhost:1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Latache <no-reply@latache.local>
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_VERIFY_ON_BOOTSTRAP=false

# Backend-generated and admin-managed dynamic content locales. English is the
# canonical/default fallback; add a locale here before administrators may save it.
SUPPORTED_LOCALES=en,ar,ary
DEFAULT_LOCALE=en

# Gmail SMTP example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-account@gmail.com
# SMTP_PASSWORD=your-google-app-password
# SMTP_FROM=Latache <your-account@gmail.com>

# Canonical super administrator seed. Always override the password in a real
# staging or production environment before running the seed.
SUPERADMIN_EMAIL=latache.superadmin@yopmail.com
SUPERADMIN_PASSWORD=Admin@12345


# Tasker wallet and payouts. Wallet data remains zero/empty until real settlements occur.
TASKER_WALLET_CURRENCY=USD
# disabled = no withdrawal reservations; manual = reserve funds and create pending_review only.
TASKER_PAYOUT_EXECUTION_MODE=disabled
TASKER_MIN_WITHDRAWAL_AMOUNT=1
# 32 random bytes as base64, or 64 hex characters. Required only to store payout details.
PAYOUT_DATA_ENCRYPTION_KEY=

# Tasker earnings clearance. BullMQ schedules this when JOBS_ENABLED=true; the
# interval is only a Redis-free development fallback. PostgreSQL row locks,
# persisted release state, and idempotent ledgers prevent duplicate release.
TASKER_EARNINGS_WORKER_ENABLED=true
TASKER_EARNINGS_WORKER_POLL_MS=60000
TASKER_EARNINGS_WORKER_BATCH_SIZE=100
# Bootstrap defaults only. Finance can persist policy through the taskerFinance
# section of PUT /api/admin/platform-settings.
TASKER_EARNINGS_CLEARANCE_DAYS=14
TASKER_CASH_DISPUTE_CLEARANCE_DAYS=14

# Customer payments (Stripe)
# Keep false until real Stripe credentials and webhook are configured.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_CURRENCY=USD
# Bootstrap/default commission used only until a DB-backed commission policy is saved via /api/admin/platform-settings.
PAYMENTS_PLATFORM_FEE_PERCENT=0
BOOKING_MINIMUM_BILLABLE_MINUTES=120
CUSTOMER_WALLET_MIN_TOPUP=5

# Booking conversation attachments. Reuses /api/uploads/single and /multiple
# with folder=conversation-attachments. The multipart interceptor caps each
# file at 10 MB and the application also enforces the message-level limits.
CHAT_ATTACHMENT_MAX_FILES=5
CHAT_ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
CHAT_ATTACHMENT_MAX_TOTAL_SIZE_BYTES=26214400

# One-to-one Customer/Tasker WebRTC calls. Socket.IO /realtime carries only
# authenticated signaling and lifecycle events; audio/video does not pass
# through or get recorded by the NestJS API.
CHAT_CALLS_ENABLED=true
CHAT_CALL_RING_TIMEOUT_SECONDS=45
CHAT_CALL_MAX_DURATION_SECONDS=14400
CHAT_CALL_SWEEP_MS=5000
CHAT_CALL_SIGNAL_MAX_PER_MINUTE=300
CHAT_CALL_ALLOWED_BOOKING_STATUSES=confirmed,en_route,arrived,in_progress

# Comma-separated WebRTC ICE server URLs. STUN alone may work in development,
# but a TURN relay is required by environment validation in staging/production
# whenever calls are enabled. Use either a coturn shared secret (recommended)
# or a static username + credential pair, never both credential modes.
WEBRTC_STUN_URLS=
WEBRTC_TURN_URLS=
WEBRTC_TURN_SHARED_SECRET=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
WEBRTC_TURN_CREDENTIAL_TTL_SECONDS=3600
