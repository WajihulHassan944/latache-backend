NODE_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
APP_TIMEZONE=Africa/Casablanca
REQUEST_BODY_LIMIT=1mb
SWAGGER_ENABLED=true
TRUST_PROXY=false
ALLOW_QUERY_TOKEN_COMPATIBILITY=false

# Local PostgreSQL example:
DATABASE_URL=postgresql://latache:latache@localhost:5432/latache?schema=public

# Neon example (replace every placeholder; never commit the real password):
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require
# DIRECT_URL can be omitted for a direct Neon URL. If DATABASE_URL uses a pooled
# Neon host, set DIRECT_URL to the non-pooled connection string for migrations.
DIRECT_URL=
DB_LOGGING=false

JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_SECRET_ADMIN=replace-with-an-independent-random-secret-of-at-least-32-characters
PASSWORD_RESET_JWT_SECRET=replace-with-a-third-independent-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m
PASS_JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
BCRYPT_ROUNDS=12
OTP_EXPIRES_IN_MINUTES=5

# Local Docker Compose uses Mailpit on localhost:1025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Latache <no-reply@latache.local>
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_VERIFY_ON_BOOTSTRAP=false

# Gmail SMTP example:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-account@gmail.com
# SMTP_PASSWORD=your-google-app-password
# SMTP_FROM=Latache <your-account@gmail.com>
