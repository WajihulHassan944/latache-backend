generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           Int       @id @default(autoincrement())
  firstName                    String?   @default("") @db.VarChar(255)
  lastName                     String?   @default("") @db.VarChar(255)
  email                        String    @unique(map: "Users_email_key") @db.VarChar(255)
  phoneCountryCode             String?   @default("") @db.VarChar(8)
  phoneNumber                  String?   @default("") @db.VarChar(255)
  preferredLanguage            String?   @db.VarChar(10)
  otp                          Int?
  otpExpires                   DateTime? @db.Timestamptz(6)
  otpAttempts                  Int       @default(0)
  password                     String?   @db.VarChar(255)
  zipCode                      String?   @db.VarChar(255)
  passwordResetCode            Int?
  passwordResetCodeExpires     DateTime? @db.Timestamptz(6)
  passwordResetAttempts        Int       @default(0)
  profilePicture               String?   @default("") @db.VarChar(255)
  role                         String    @default("") @db.VarChar(255)
  accountStatus                String    @default("active") @db.VarChar(32)
  adminRole                    String?   @db.VarChar(64)
  permissions                  String[]  @default([]) @db.VarChar(100)
  rbacRoleId                   String?   @db.VarChar(40)
  inheritsRolePermissions      Boolean   @default(true)
  mustChangePassword           Boolean   @default(false)
  lastLoginAt                  DateTime? @db.Timestamptz(6)
  acceptedTermsAt              DateTime? @db.Timestamptz(6)
  acceptedPrivacyAt            DateTime? @db.Timestamptz(6)
  createdById                  Int?
  deletedAt                    DateTime? @db.Timestamptz(6)
  bio                          String?   @db.Text
  isVerified                   Boolean   @default(false)
  isAdmin                      Boolean   @default(false)
  isProfilePublic              Boolean   @default(false)
  isDocVerified                Boolean   @default(false)
  authType                     String?   @default("") @db.VarChar(255)
  docType                      String?   @default("") @db.VarChar(255)
  dateOfBirth                  String?   @default("") @db.VarChar(255)
  yearsOfExperience            Int?
  hourlyRate                   Decimal?  @db.Decimal(10, 2)
  idType                       String?   @db.VarChar(255)
  identityDocument             Json?     @db.JsonB
  serviceAreaLabel             String?   @db.VarChar(255)
  serviceAreaLat               Decimal?  @db.Decimal(9, 6)
  serviceAreaLng               Decimal?  @db.Decimal(9, 6)
  serviceAreaRadiusKm          Decimal?  @db.Decimal(6, 2)
  serviceAreaCity              String?   @db.VarChar(255)
  serviceAreaArea              String?   @db.VarChar(255)
  onboardingStatus             String?   @db.VarChar(255)
  submittedAt                  DateTime? @db.Timestamptz(6)
  rating                       Decimal   @default(0) @db.Decimal(2, 1)
  reviewsCount                 Int       @default(0)
  completedTasks               Int       @default(0)
  vehicles                     String[]  @default([]) @db.VarChar(255)
  workImages                   String[]  @default([]) @db.VarChar(255)
  isElite                      Boolean   @default(false)
  eliteTierId                  String?   @db.VarChar(40)
  eliteSince                   DateTime? @db.Timestamptz(6)
  aboutMe                      String?   @db.Text
  skills                       String[]  @default([]) @db.VarChar(255)
  stripeCustomerId             String?   @unique(map: "Users_stripeCustomerId_key") @db.VarChar(255)
  defaultStripePaymentMethodId String?   @db.VarChar(255)
  createdAt                    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  refreshTokens               RefreshToken[]
  userServices                UserService[]
  availability                UserAvailability[]
  bookingsAsCustomer          Booking[]                   @relation("CustomerBookings")
  bookingsAsTasker            Booking[]                   @relation("TaskerBookings")
  createdBy                   User?                       @relation("AdminCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAdmins               User[]                      @relation("AdminCreator")
  rbacRole                    RbacRole?                   @relation(fields: [rbacRoleId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Users_rbacRoleId_fkey")
  taskerWallet                TaskerWallet?
  payoutMethods               TaskerPayoutMethod[]
  walletLedgerEntries         TaskerWalletLedgerEntry[]
  taskerEarnings              TaskerEarning[]             @relation("TaskerEarningsTasker")
  platformAccount             TaskerPlatformAccount?
  platformReceivables         TaskerPlatformReceivable[]  @relation("TaskerPlatformReceivablesTasker")
  platformLedgerEntries       TaskerPlatformLedgerEntry[] @relation("TaskerPlatformLedgerTasker")
  cashPaymentsConfirmed       TaskerPlatformReceivable[]  @relation("TaskerPlatformReceivableConfirmer")
  withdrawalRequests          TaskerWithdrawal[]
  taskWorkSessions            TaskWorkSession[]
  taskLocations               TaskerTaskLocation[]
  taskComplaintsFiled         TaskComplaint[]             @relation("TaskComplaintFiledBy")
  disputesAssigned            TaskComplaint[]             @relation("DisputeAssignedAdmin")
  disputesResolved            TaskComplaint[]             @relation("DisputeResolvedBy")
  disputeEvidenceUploaded     DisputeEvidence[]           @relation("DisputeEvidenceUploader")
  disputeEvidenceReviewed     DisputeEvidence[]           @relation("DisputeEvidenceReviewer")
  disputeEvidenceRequestsMade DisputeEvidenceRequest[]    @relation("DisputeEvidenceRequester")
  disputeResolutions          DisputeResolution[]         @relation("DisputeResolutionActor")
  taskMessagesSent            TaskMessage[]               @relation("TaskMessageSender")
  conversationCallsInitiated  ConversationCall[]          @relation("ConversationCallInitiator")
  conversationCallsReceived   ConversationCall[]          @relation("ConversationCallRecipient")
  conversationCallsEnded      ConversationCall[]          @relation("ConversationCallEndedBy")
  notifications               TaskNotification[]
  reviewsWritten              Review[]                    @relation("ReviewsWritten")
  reviewsReceived             Review[]                    @relation("ReviewsReceived")
  reviewsModerated            Review[]                    @relation("ReviewsModerated")
  favoriteTaskers             FavoriteTasker[]            @relation("CustomerFavoriteTaskers")
  favoritedByCustomers        FavoriteTasker[]            @relation("FavoritedTasker")
  customerWallet              CustomerWallet?
  customerWalletLedger        CustomerWalletLedgerEntry[]
  paymentTransactions         PaymentTransaction[]
  adminAuditActions           AdminAuditLog[]             @relation("AdminAuditActor")
  adminAuditTargets           AdminAuditLog[]             @relation("AdminAuditTarget")
  eliteTier                   EliteTier?                  @relation("EliteTierMembers", fields: [eliteTierId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Users_eliteTierId_fkey")
  eliteRequests               EliteMembershipRequest[]    @relation("EliteRequestTasker")
  eliteDecisions              EliteMembershipRequest[]    @relation("EliteRequestDecider")
  eliteTransitions            EliteTierTransition[]       @relation("EliteTransitionTasker")
  eliteTransitionsActed       EliteTierTransition[]       @relation("EliteTransitionActor")
  eliteBadges                 EliteTaskerBadge[]          @relation("EliteBadgeTasker")
  eliteBadgesAwarded          EliteTaskerBadge[]          @relation("EliteBadgeAwarder")
  supportTickets              SupportTicket[]             @relation("SupportTicketRequester")
  supportTicketsAssigned      SupportTicket[]             @relation("SupportTicketAssignee")
  supportMessagesSent         SupportTicketMessage[]      @relation("SupportTicketMessageSender")

  @@index([role, onboardingStatus], map: "users_role_onboarding_idx")
  @@index([role, accountStatus], map: "users_role_status_idx")
  @@index([createdById], map: "users_created_by_idx")
  @@index([rbacRoleId], map: "users_rbac_role_idx")
  @@index([eliteTierId, accountStatus], map: "users_elite_tier_status_idx")
  @@map("Users")
}

model EliteTier {
  id           String   @id @default(cuid()) @db.VarChar(40)
  code         String   @unique(map: "EliteTiers_code_key") @db.VarChar(32)
  name         String   @db.VarChar(80)
  rank         Int      @unique(map: "EliteTiers_rank_key")
  description  String?  @db.VarChar(500)
  requirements Json?    @db.JsonB
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  members      User[]                 @relation("EliteTierMembers")
  benefits     EliteBenefit[]
  badges       EliteBadge[]
  translations EliteTierTranslation[]

  @@index([isActive, rank], map: "elite_tiers_active_rank_idx")
  @@map("EliteTiers")
}

model EliteTierTranslation {
  id          String   @id @default(cuid()) @db.VarChar(40)
  tierId      String   @db.VarChar(40)
  locale      String   @db.VarChar(10)
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tier EliteTier @relation(fields: [tierId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "EliteTierTranslations_tierId_fkey")

  @@unique([tierId, locale], map: "elite_tier_translations_tier_locale_unique")
  @@index([locale, name], map: "elite_tier_translations_locale_name_idx")
  @@map("EliteTierTranslations")
}

model EliteMembershipRequest {
  id                   String    @id @default(cuid()) @db.VarChar(40)
  taskerId             Int
  kind                 String    @db.VarChar(32)
  fromTierCode         String?   @db.VarChar(32)
  toTierCode           String?   @db.VarChar(32)
  status               String    @default("pending") @db.VarChar(32)
  reason               String?   @db.VarChar(1000)
  decisionReason       String?   @db.VarChar(1000)
  metricsSnapshot      Json?     @db.JsonB
  requirementsSnapshot Json?     @db.JsonB
  decidedById          Int?
  decidedAt            DateTime? @db.Timestamptz(6)
  cancelledAt          DateTime? @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  tasker     User                 @relation("EliteRequestTasker", fields: [taskerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "EliteMembershipRequests_taskerId_fkey")
  decidedBy  User?                @relation("EliteRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "EliteMembershipRequests_decidedById_fkey")
  transition EliteTierTransition?

  @@index([taskerId, status, createdAt], map: "elite_requests_tasker_status_created_idx")
  @@index([status, kind, createdAt], map: "elite_requests_status_kind_created_idx")
  @@index([decidedById, decidedAt], map: "elite_requests_decider_decided_idx")
  @@map("EliteMembershipRequests")
}

model EliteTierTransition {
  id           String   @id @default(cuid()) @db.VarChar(40)
  taskerId     Int
  requestId    String?  @unique(map: "EliteTierTransitions_requestId_key") @db.VarChar(40)
  fromTierCode String?  @db.VarChar(32)
  toTierCode   String?  @db.VarChar(32)
  source       String   @db.VarChar(32)
  reason       String?  @db.VarChar(1000)
  actorId      Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  tasker  User                    @relation("EliteTransitionTasker", fields: [taskerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "EliteTierTransitions_taskerId_fkey")
  request EliteMembershipRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "EliteTierTransitions_requestId_fkey")
  actor   User?                   @relation("EliteTransitionActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "EliteTierTransitions_actorId_fkey")

  @@index([taskerId, createdAt], map: "elite_transitions_tasker_created_idx")
  @@index([toTierCode, createdAt], map: "elite_transitions_to_tier_created_idx")
  @@map("EliteTierTransitions")
}

model EliteBenefit {
  id           String   @id @default(cuid()) @db.VarChar(40)
  tierId       String   @db.VarChar(40)
  code         String   @db.VarChar(64)
  name         String   @db.VarChar(120)
  description  String?  @db.VarChar(500)
  displayValue String?  @db.VarChar(120)
  metadata     Json?    @db.JsonB
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tier         EliteTier                 @relation(fields: [tierId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "EliteBenefits_tierId_fkey")
  translations EliteBenefitTranslation[]

  @@unique([tierId, code], map: "elite_benefits_tier_code_unique")
  @@index([tierId, isActive, sortOrder], map: "elite_benefits_tier_active_sort_idx")
  @@map("EliteBenefits")
}

model EliteBenefitTranslation {
  id           String   @id @default(cuid()) @db.VarChar(40)
  benefitId    String   @db.VarChar(40)
  locale       String   @db.VarChar(10)
  name         String   @db.VarChar(120)
  description  String?  @db.VarChar(500)
  displayValue String?  @db.VarChar(120)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  benefit EliteBenefit @relation(fields: [benefitId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "EliteBenefitTranslations_benefitId_fkey")

  @@unique([benefitId, locale], map: "elite_benefit_translations_benefit_locale_unique")
  @@index([locale, name], map: "elite_benefit_translations_locale_name_idx")
  @@map("EliteBenefitTranslations")
}

model EliteBadge {
  id          String   @id @default(cuid()) @db.VarChar(40)
  tierId      String?  @db.VarChar(40)
  code        String   @unique(map: "EliteBadges_code_key") @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  assetUrl    String?  @db.VarChar(1000)
  criteria    Json?    @db.JsonB
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tier         EliteTier?              @relation(fields: [tierId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "EliteBadges_tierId_fkey")
  assignments  EliteTaskerBadge[]
  translations EliteBadgeTranslation[]

  @@index([tierId, isActive], map: "elite_badges_tier_active_idx")
  @@map("EliteBadges")
}

model EliteBadgeTranslation {
  id          String   @id @default(cuid()) @db.VarChar(40)
  badgeId     String   @db.VarChar(40)
  locale      String   @db.VarChar(10)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  badge EliteBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "EliteBadgeTranslations_badgeId_fkey")

  @@unique([badgeId, locale], map: "elite_badge_translations_badge_locale_unique")
  @@index([locale, name], map: "elite_badge_translations_locale_name_idx")
  @@map("EliteBadgeTranslations")
}

model EliteTaskerBadge {
  id           String    @id @default(cuid()) @db.VarChar(40)
  taskerId     Int
  badgeId      String    @db.VarChar(40)
  awardedById  Int?
  awardedAt    DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)
  revokeReason String?   @db.VarChar(500)

  tasker    User       @relation("EliteBadgeTasker", fields: [taskerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "EliteTaskerBadges_taskerId_fkey")
  badge     EliteBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "EliteTaskerBadges_badgeId_fkey")
  awardedBy User?      @relation("EliteBadgeAwarder", fields: [awardedById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "EliteTaskerBadges_awardedById_fkey")

  @@unique([taskerId, badgeId], map: "elite_tasker_badges_tasker_badge_unique")
  @@index([taskerId, revokedAt], map: "elite_tasker_badges_tasker_revoked_idx")
  @@index([badgeId, revokedAt], map: "elite_tasker_badges_badge_revoked_idx")
  @@map("EliteTaskerBadges")
}

model PlatformSetting {
  key         String   @id @db.VarChar(64)
  value       Json     @db.JsonB
  version     Int      @default(1)
  updatedById Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([updatedAt], map: "platform_settings_updated_idx")
  @@map("PlatformSettings")
}

model AdminAuditLog {
  id           String   @id @default(cuid()) @db.VarChar(40)
  actorId      Int?
  targetUserId Int?
  action       String   @db.VarChar(80)
  entityType   String   @db.VarChar(64)
  entityId     String?  @db.VarChar(64)
  reason       String?  @db.VarChar(1000)
  metadata     Json?    @db.JsonB
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  actor      User? @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "AdminAuditLogs_actorId_fkey")
  targetUser User? @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "AdminAuditLogs_targetUserId_fkey")

  @@index([actorId, createdAt], map: "admin_audit_actor_created_idx")
  @@index([targetUserId, createdAt], map: "admin_audit_target_created_idx")
  @@index([entityType, entityId, createdAt], map: "admin_audit_entity_created_idx")
  @@index([action, createdAt], map: "admin_audit_action_created_idx")
  @@index([createdAt, id], map: "admin_audit_created_cursor_idx")
  @@map("AdminAuditLogs")
}

model RbacRole {
  id          String    @id @default(cuid()) @db.VarChar(40)
  code        String    @unique(map: "RbacRoles_code_key") @db.VarChar(64)
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  permissions String[]  @default([]) @db.VarChar(100)
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  deletedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  users User[]

  @@index([isActive, isSystem], map: "rbac_roles_active_system_idx")
  @@map("RbacRoles")
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String?  @db.VarChar(255)
  description String?  @db.Text
  slug        String?  @db.VarChar(255)
  icon        String?  @db.VarChar(255)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  userServices UserService[]
  bookings     Booking[]
  options      ServiceOption[]
  translations ServiceTranslation[]

  @@index([isActive, sortOrder], map: "services_active_sort_idx")
  @@map("Services")
}

model ServiceTranslation {
  id                    String   @id @default(cuid()) @db.VarChar(40)
  serviceId             Int
  locale                String   @db.VarChar(10)
  name                  String   @db.VarChar(255)
  description           String?  @db.Text
  normalizedName        String   @db.VarChar(255)
  normalizedDescription String?  @db.Text
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "ServiceTranslations_serviceId_fkey")

  @@unique([serviceId, locale], map: "service_translations_service_locale_unique")
  @@index([locale, normalizedName], map: "service_translations_locale_name_idx")
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "service_translations_normalized_name_trgm_idx")
  @@index([normalizedDescription(ops: raw("gin_trgm_ops"))], type: Gin, map: "service_translations_normalized_description_trgm_idx")
  @@map("ServiceTranslations")
}

model RefreshToken {
  id                  Int       @id @default(autoincrement())
  userId              Int
  tokenHash           String    @unique(map: "RefreshTokens_tokenHash_key") @db.VarChar(255)
  device              String?   @db.VarChar(255)
  ipAddress           String?   @db.VarChar(64)
  userAgent           String?   @db.VarChar(512)
  lastUsedAt          DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt           DateTime  @db.Timestamptz(6)
  revokedAt           DateTime? @db.Timestamptz(6)
  replacedByTokenHash String?   @db.VarChar(255)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "RefreshTokens_userId_fkey")

  @@index([userId, revokedAt], map: "refresh_tokens_user_revoked_idx")
  @@map("RefreshTokens")
}

model UserService {
  id         Int      @id @default(autoincrement())
  userId     Int
  serviceId  Int
  hourlyRate Decimal  @default(0) @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "UserServices_userId_fkey")
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "UserServices_serviceId_fkey")

  @@unique([userId, serviceId], map: "user_services_user_id_service_id_unique")
  @@index([serviceId, hourlyRate], map: "user_services_service_rate_idx")
  @@map("UserServices")
}

model UserAvailability {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime @db.Date
  startTime String   @db.VarChar(255)
  endTime   String   @db.VarChar(255)
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "UserAvailabilities_userId_fkey")
  booking Booking?

  @@index([userId, date], map: "user_availabilities_user_id_date")
  @@index([userId, date, isBooked], map: "user_availabilities_open_slot_idx")
  @@map("UserAvailabilities")
}

model Booking {
  id                       Int       @id @default(autoincrement())
  customerId               Int
  taskerId                 Int
  serviceId                Int
  serviceOptionId          Int?
  availabilityId           Int       @unique(map: "Bookings_availabilityId_key")
  hourlyRate               Decimal   @db.Decimal(10, 2)
  bookingDate              DateTime  @db.Date
  startTime                String    @db.VarChar(255)
  endTime                  String    @db.VarChar(255)
  venueAddress             String    @db.VarChar(255)
  apartmentSuite           String?   @db.VarChar(255)
  description              String    @db.Text
  attachments              Json?     @db.JsonB
  locationLabel            String    @db.VarChar(255)
  locationLat              Decimal   @db.Decimal(9, 6)
  locationLng              Decimal   @db.Decimal(9, 6)
  locationCity             String?   @db.VarChar(255)
  locationArea             String?   @db.VarChar(255)
  status                   String    @default("pending") @db.VarChar(255)
  confirmedAt              DateTime? @db.Timestamptz(6)
  enRouteAt                DateTime? @db.Timestamptz(6)
  arrivedAt                DateTime? @db.Timestamptz(6)
  taskStartedAt            DateTime? @db.Timestamptz(6)
  taskCompletedAt          DateTime? @db.Timestamptz(6)
  cancelledAt              DateTime? @db.Timestamptz(6)
